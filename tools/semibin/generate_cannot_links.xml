<tool id="semibin_generate_cannot_links" name="SemiBin: Generate cannot-links" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>
        for semi-supervised binning
    </description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="version"/>
    <command detect_errors="aggressive"><![CDATA[
#import re
@FASTA_FILES@

SemiBin2 generate_cannot_links
    --input-fasta 'contigs.$input_fasta.ext'
    --output 'output'
    --cannot-name 'cannot'
#if $ref.select == 'cached'
    --reference-db-data-dir '$ref.cached_db.fields.path'
#else if $ref.select == 'taxonomy'
    --taxonomy-annotation-table '$ref.taxonomy'
#end if
    --threads "\${GALAXY_SLOTS:-1}"
    --processes "\${GALAXY_SLOTS:-1}"
#if $ml_threshold:
    --ml-threshold $ml_threshold
#end if
#if $allow_missing_mmseqs2:
    --allow-missing-mmseqs2
#end if
    ]]></command>
    <inputs>
        <expand macro="mode_select"/>
        <conditional name="mode">
            <param name="select" value="single"/>
            <expand macro="input-fasta-single"/>
            <expand macro="ref-single-cannot"/>
        </conditional>
        <expand macro="ml-threshold"/>
        <param name="allow_missing_mmseqs2" type="boolean" truevalue="--allow-missing-mmseqs2" falsevalue="" checked="false" label="Allow missing mmseqs2" help="Allow running without mmseqs2 (only for testing)"/>
    </inputs>
    <outputs>
        <expand macro="cannot_link_output"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="input_fasta" ftype="fasta" value="input_single.fasta"/>
            <conditional name="ref">
                <param name="select" value="taxonomy"/>
                <param name="taxonomy" ftype="tabular" value="taxonomy.tsv"/>
            </conditional>
            <output name="cannot" ftype="txt">
                <assert_contents>
                    <has_n_lines n="3"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="input_fasta" ftype="fasta.gz" value="input_single.fasta.gz"/>
            <conditional name="ref">
                <param name="select" value="cached"/>
                <param name="cached_db" value="test-db"/>
            </conditional>
            <output name="cannot" ftype="txt">
                <assert_contents>
                    <has_n_lines n="3"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="input_fasta" ftype="fasta.bz2" value="input_single.fasta.bz2"/>
            <conditional name="ref">
                <param name="select" value="taxonomy"/>
                <param name="taxonomy" ftype="tabular" value="taxonomy.tsv"/>
            </conditional>
            <param name="ml_threshold" value="4000"/>
            <output name="cannot" ftype="txt">
                <assert_contents>
                    <has_n_lines n="3"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
@HELP_HEADER@

This tool generates cannot-links for semi-supervised binning.

## Inputs

@HELP_INPUT_FASTA@

## Reference database

- Cached database: Use a pre-cached GTDB database
- Taxonomy: Use a pre-computed taxonomy file

## Outputs

- Cannot-link constraints file
    ]]></help>
    <expand macro="citations"/>
</tool>
