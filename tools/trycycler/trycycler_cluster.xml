<tool id="trycycler_cluster" name="Trycycler cluster" version="@TOOL_VERSION@" profile="20.01">
    <description>cluster the contigs of your input assemblies into per-replicon groups</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="edam_ontology"/>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <version_command>trycycler --version</version_command>
    <command detect_errors="aggressive"><![CDATA[
        #import re
        mkdir -p initial_clusters assemblies &&
        #for $input_file in $assemblies
            #set $name = re.sub('[^\\w\\-\\.]', '_', str($input_file.element_identifier))
            ln -s '$input_file' 'assemblies/$name' &&
        #end for
        trycycler cluster --assemblies assemblies/* \
            --reads '$reads' \
            --min_contig_len $min_contig_len \
            --min_contig_depth $min_contig_depth \
            --distance $distance \
            --threads \${GALAXY_SLOTS:-2} \
            --out_dir 'initial_clusters' &&
        mv initial_clusters/contigs.phylip '$output_phylip' &&
        mv initial_clusters/contigs.newick '$output_newick' && 
        python3 '$__tool_directory__/trycycler.py' 'cluster' 'initial_clusters'
    ]]></command>
    <inputs>
        <param name="assemblies" type="data" format="fasta,fasta.gz" multiple="true" label="Assembled sequences datasets"/>
        <param name="reads" type="data" format="fastq,fastq.gz" label="Long-read datasets"/>
        <param argument="--min_contig_len" type="integer" min="100" max="5000" value="1000" label="Minimum contig length"/>
        <param argument="--min_contig_depth" type="float" min="0.01" max="1" value="0.1" label="Minimum contig depth"/>
        <param argument="--distance" type="float" min="0.001" max="0.1" value="0.01" label="Mash distance threshold"/>
    </inputs>
    <outputs>
        <data name="output_phylip" format="phylip" label="${tool.name} on ${on_string}: phylip"/>
        <data name="output_newick" format="newick" label="${tool.name} on ${on_string}: newick"/>
        <collection name="initial_clusters" type="list" label="${tool.name} on ${on_string}">
            <discover_datasets pattern="__designation_and_ext__" format="fasta" directory="initial_clusters"/>
        </collection>
    </outputs>
    <tests>
        <test expect_num_outputs="2">
            <param name="assemblies" value="assembly_00.fasta.gz"/>
            <param name="reads" value="reads.fastq.gz"/>
            <output name="output_phylip" file="contigs_01.phylip" ftype="phylip"/>
            <output name="output_newick" file="contigs_01.newick" ftype="newick"/>
            <output_collection name="initial_clusters" type="list" count="1">
                <element name="cluster_01" file="cluster_01.fasta" ftype="fasta"/>
            </output_collection>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

The *Trycycler cluster* tool clusters contigs from multiple assemblies using Mash distances.

@PIPELINE@
    ]]></help>
    <expand macro="citations"/>
</tool>
