<?xml version="1.0"?>
<data_managers>
    <data_manager tool_file="data_manager/crisprtarget_build_database.xml" id="crisprtarget_build_database" version="1.0">
        <data_table name="crispr_target_databases">
            <output>
                <column name="value"/>
                <column name="name"/>
                <column name="db_path" output_ref="out_file">
                    <move type="directory" relativize_symlinks="True">
                        <source>${db_path}</source>
                        <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">crispr_target_databases/${db_path}</target>
                    </move>
                    <!-- the data table stores the FASTA file, not the directory -->
                    <value_translation>${GALAXY_DATA_MANAGER_DATA_PATH}/crispr_target_databases/${db_path}/${db_path}.fa</value_translation>
                    <value_translation type="function">abspath</value_translation>
                </column>
                <column name="ctrl_db" output_ref="out_file">
                    <move type="directory" relativize_symlinks="True">
                        <source>${ctrl_db}</source>
                        <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">crispr_target_databases/${ctrl_db}</target>
                    </move>
                    <value_translation>${GALAXY_DATA_MANAGER_DATA_PATH}/crispr_target_databases/${ctrl_db}/${ctrl_db}.fa</value_translation>
                    <value_translation type="function">abspath</value_translation>
                </column>
                <column name="dbsize"/>
            </output>
        </data_table>
        <citation type="doi">10.4161/rna.24046</citation>
    </data_manager>
</data_managers>
